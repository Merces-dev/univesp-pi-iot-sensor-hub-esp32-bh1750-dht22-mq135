diff --git a/backend/src/measurements/measurement.entity.ts b/backend/src/measurements/measurement.entity.ts
new file mode 100644
index 0000000..dc0bab8
--- /dev/null
+++ b/backend/src/measurements/measurement.entity.ts
@@ -0,0 +1,35 @@
+import { Column, CreateDateColumn, Entity, Index, PrimaryGeneratedColumn } from "typeorm";
+
+// O driver pg devolve NUMERIC como texto; converte para número na leitura.
+const numeric = {
+  to: (v: number | null) => v,
+  from: (v: string | null) => (v === null ? null : parseFloat(v)),
+};
+
+@Entity({ name: "measurements" })
+export class Measurement {
+  @PrimaryGeneratedColumn()
+  id: number;
+
+  @Column({ type: "numeric", nullable: true, transformer: numeric })
+  temperature: number | null;
+
+  @Column({ type: "numeric", nullable: true, transformer: numeric })
+  humidity: number | null;
+
+  @Column({ type: "numeric", nullable: true, transformer: numeric })
+  luminosity: number | null;
+
+  @Column({ name: "heat_index", type: "numeric", nullable: true, transformer: numeric })
+  heatIndex: number | null;
+
+  @Column({ name: "air_quality", type: "numeric", nullable: true, transformer: numeric })
+  airQuality: number | null;
+
+  @Column({ name: "device_id", type: "varchar", length: 80 })
+  deviceId: string;
+
+  @Index()
+  @CreateDateColumn({ name: "created_at", type: "timestamp" })
+  createdAt: Date;
+}
diff --git a/backend/src/measurements/measurements.controller.ts b/backend/src/measurements/measurements.controller.ts
new file mode 100644
index 0000000..0c0df67
--- /dev/null
+++ b/backend/src/measurements/measurements.controller.ts
@@ -0,0 +1,35 @@
+import { BadRequestException, Controller, Get, Query } from "@nestjs/common";
+import { MeasurementsService } from "./measurements.service";
+
+function parseDate(value?: string): Date | undefined {
+  if (!value) return undefined;
+  const d = new Date(value);
+  if (isNaN(d.getTime())) throw new BadRequestException(`Data inválida: ${value}`);
+  return d;
+}
+
+@Controller("measurements")
+export class MeasurementsController {
+  constructor(private readonly service: MeasurementsService) {}
+
+  @Get()
+  list(@Query("from") from?: string, @Query("to") to?: string, @Query("limit") limit?: string) {
+    return this.service.findByPeriod(parseDate(from), parseDate(to), limit ? parseInt(limit, 10) || 100 : 100);
+  }
+
+  @Get("summary")
+  summary(@Query("from") from?: string, @Query("to") to?: string) {
+    return this.service.summary(parseDate(from), parseDate(to));
+  }
+}
+
+@Controller("health")
+export class HealthController {
+  constructor(private readonly service: MeasurementsService) {}
+
+  @Get()
+  async health() {
+    const db = await this.service.databaseIsUp();
+    return { status: db ? "ok" : "degraded", database: db ? "up" : "down" };
+  }
+}
